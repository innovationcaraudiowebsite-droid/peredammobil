diff --git a/src/lib/db.ts b/src/lib/db.ts
index 126b85f..058ae53 100755
--- a/src/lib/db.ts
+++ b/src/lib/db.ts
@@ -38,6 +38,7 @@ interface FindOptions {
 interface FindUniqueOptions {
   where: WhereClause
