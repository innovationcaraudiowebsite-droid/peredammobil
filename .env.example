# ============================================
# Database: Supabase Postgres (free tier)
# ============================================
# Sandbox block direct connection db.{ref}.co:5432 → use Supavisor session
# pooler port 5432 (IPv4). Session mode supports DDL/schema push; transaction
# mode (port 6543) does not. Password should be URL-encoded (e.g. @ → %40).
# connection_limit=1 keeps Prisma from exhausting the small Supabase pool.
DATABASE_URL=postgresql://postgres.{ref}:your-password@aws-0-{region}.pooler.supabase.com:5432/postgres?connection_limit=1
# For Vercel serverless / transaction pooler:
# DATABASE_URL=postgresql://postgres.{ref}:your-password@aws-0-{region}.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ============================================
# Supabase Storage & API (server-side only — NEVER expose these)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# ============================================
# Supabase Storage & API (client-side, safe to expose via NEXT_PUBLIC_*)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ============================================
# Admin Auth — generate your own credentials!
# Generate random password: openssl rand -base64 16
# Generate random session secret: openssl rand -hex 32
# ============================================
ADMIN_EMAIL=admin@peredammobiljakarta.com
ADMIN_PASSWORD=your-strong-password
ADMIN_SESSION_SECRET=your-random-32-hex

# ============================================
# Google Analytics (optional, fill after GA4 setup)
# ============================================
NEXT_PUBLIC_GA_ID=
