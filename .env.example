# ===================================================================
# .env.example — Template Environment Variables
# ===================================================================
# Copy this file to .env (or set in Vercel Dashboard) and replace
# placeholder values with your actual credentials.
#
# Untuk Vercel: Project Settings → Environment Variables → Add New
# Untuk setiap var, centang: [x] Production [x] Preview [x] Development
#
# ⚠️ JANGAN COMMIT file .env asli ke Git. Hanya .env.example yang aman.
# ===================================================================


# --- SUPABASE (server-side, rahasia) ---
# Dari: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxx


# --- SUPABASE (client-side, aman di-expose) ---
# Dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx


# --- ADMIN AUTH (custom cookie session) ---
# Email admin pertama (untuk login dashboard)
ADMIN_EMAIL=admin@peredammobiljakarta.com

# Password admin pertama — digunakan seed/setup-admin.ts untuk create
# user di Supabase Auth. Setelah admin ter-create, password disimpan di
# Supabase Auth (bukan env var). Generate strong password:
#   openssl rand -base64 16
ADMIN_PASSWORD=replace-with-strong-password

# Secret untuk HMAC signature cookie session (WAJIB, min 16 char).
# Generate baru:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-your-random-32-char-hex


# --- GOOGLE ANALYTICS (opsional, kosongkan kalau belum setup) ---
# Setelah setup GA4 di https://analytics.google.com, isi dengan
# Measurement ID format G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
